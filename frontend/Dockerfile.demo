# =============================================================================
# Demo Frontend Dockerfile — vite build без tsc type-check
# =============================================================================
# Используется для локального демо: TS-ошибки не ломают сборку.
# Standalone: nginx-demo.conf (fixtures-only, без API proxy и внешних сервисов).
# =============================================================================

# ---- Stage 1: Frontend build ----
FROM node:22-alpine AS builder
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx vite build

# ---- Stage 2: Demo nginx ----
FROM nginx:alpine AS production

COPY nginx-demo.conf /etc/nginx/nginx.conf
COPY --from=builder /build/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
